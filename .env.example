# Copy this file to .env and fill in your values.
# On Vercel, add the same variables in Project → Settings → Environment Variables.

# ── Public site URL (optional, defaults to https://skillissue.si) ──
# VITE_SITE_URL=https://skillissue.si

# ── Appwrite Cloud (auth, users, skills, comments, follows) ──
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_USERS_TABLE_ID=
VITE_APPWRITE_SKILLS_TABLE_ID=
VITE_APPWRITE_TESTIMONIALS_TABLE_ID=
VITE_APPWRITE_COMMENTS_TABLE_ID=
VITE_APPWRITE_FOLLOWS_TABLE_ID=
VITE_APPWRITE_AVATARS_BUCKET_ID=
# Server-side key (serverless functions / scripts only)
APPWRITE_API_KEY=

# ── Groq (AI skill builder, /api/generate) ──
GROQ_API_KEY=
VITE_GROQ_API_KEY=

# ── GitHub (skill content + crawler) ──
GITHUB_TOKEN=
VITE_GITHUB_TOKEN=

# ── MongoDB Atlas (skill index, /api/github-skills) ──
MONGODB_URI=
# MONGODB_DB=skillissue  # optional, defaults to "skillissue"

# ── Cron (crawler endpoint auth) ──
CRON_SECRET=
